<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171b20"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:background="#12171b"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/gooner_logo_mark"
                android:contentDescription="GOONER logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:text="GOONER CLIENT"
                    android:textColor="#F3F5F9"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#B39DFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="MINECRAFT CONTRACTS"
                        android:textAllCaps="true"
                        android:textColor="#A7AEC0"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/launchButton"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginTop="28dp"
            android:background="#1d232b"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="▶ LAUNCH"
            android:textColor="#F4F7FF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/modulesNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="MODULES"
                android:textAllCaps="true"
                android:textColor="#D6DBE3"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hudsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="HUDS"
                android:textAllCaps="true"
                android:textColor="#D6DBE3"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/visualsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="VISUALS"
                android:textAllCaps="true"
                android:textColor="#D6DBE3"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settingsNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="SETTINGS"
                android:textAllCaps="true"
                android:textColor="#D6DBE3"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="ACCOUNT"
                android:textAllCaps="true"
                android:textColor="#D6DBE3"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="#2d3138">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="#e7e8ea"
                android:gravity="center"
                android:text="-"
                android:textColor="#1a1a1a"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:background="#e7e8ea"
                android:gravity="center"
                android:text="□"
                android:textColor="#1a1a1a"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:background="#e7e8ea"
                android:gravity="center"
                android:text="×"
                android:textColor="#1a1a1a"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="520dp"
            android:layout_height="520dp"
            android:layout_centerInParent="true">

            <ImageView
                android:layout_width="420dp"
                android:layout_height="420dp"
                android:layout_gravity="center"
                android:src="@drawable/player_skin_preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="18dp"
                android:background="#0e1217"
                android:fontFamily="monospace"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="8dp"
                android:text="✦ liimShock"
                android:textColor="#F3F5F9"
                android:textSize="30sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>
</LinearLayout>
