package com.onyx.client.core

import android.content.Context
import androidx.core.content.edit

data class ModuleDefinition(
    val id: String,
    val displayName: String,
    val category: String,
    val description: String,
    var enabled: Boolean = false,
    val availabilityStatus: String = "available"
)

class ModuleRegistry(private val context: Context) {
    private val modules = listOf(
        ModuleDefinition(
            id = "fps_counter",
            displayName = "FPS Counter",
            category = "Visual HUD",
            description = "Measure live in-game render performance.",
            enabled = true,
            availabilityStatus = "available"
        ),
        ModuleDefinition(
            id = "coordinates",
            displayName = "Coordinates",
            category = "Visual HUD",
            description = "Show XYZ values while playing.",
            enabled = true,
            availabilityStatus = "conditional"
        ),
        ModuleDefinition(
            id = "brightness",
            displayName = "Brightness",
            category = "Visuals",
            description = "Apply safe brightness improvements for the client.",
            enabled = false,
            availabilityStatus = "experimental"
        ),
        ModuleDefinition(
            id = "performance_dashboard",
            displayName = "Performance Dashboard",
            category = "Performance",
            description = "Track runtime diagnostics and frame health.",
            enabled = true,
            availabilityStatus = "available"
        ),
        ModuleDefinition(
            id = "resource_pack_manager",
            displayName = "Resource Packs",
            category = "Resource Packs",
            description = "Manage Bedrock-compatible resource packs.",
            enabled = true,
            availabilityStatus = "available"
        ),
        ModuleDefinition(
            id = "stretch_mode",
            displayName = "Stretch Mode",
            category = "Client Settings",
            description = "Expand the client layout horizontally for a wide 16:9 feel.",
            enabled = false,
            availabilityStatus = "available"
        )
    )

    fun getModules(): List<ModuleDefinition> = modules

    fun toggle(id: String, enabled: Boolean) {
        val target = modules.firstOrNull { it.id == id } ?: return
        target.enabled = enabled
        persistState()
    }

    private fun persistState() {
        val prefs = context.getSharedPreferences("module_registry", Context.MODE_PRIVATE)
        prefs.edit {
            modules.forEach { module ->
                putBoolean(module.id, module.enabled)
            }
        }
    }
}

