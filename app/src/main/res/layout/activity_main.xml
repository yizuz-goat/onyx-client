<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="#0D1118"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#111827"
            android:gravity="center"
            android:text="✦"
            android:textColor="#A78BFA"
            android:textSize="18sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="24dp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#8B5CF6"
            android:gravity="center"
            android:text="PLAY"
            android:textColor="#FFFFFF"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="#161D2A"
            android:gravity="center"
            android:text="PROFILES"
            android:textColor="#D5D7E2"
            android:textSize="7sp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="#161D2A"
            android:gravity="center"
            android:text="MODS"
            android:textColor="#D5D7E2"
            android:textSize="7sp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="#161D2A"
            android:gravity="center"
            android:text="SKIN"
            android:textColor="#D5D7E2"
            android:textSize="7sp" />

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:background="#161D2A"
            android:gravity="center"
            android:text="MAPS"
            android:textColor="#D5D7E2"
            android:textSize="7sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="#111827"
            android:gravity="center"
            android:text="⚙"
            android:textColor="#D5D7E2"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0D1118"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOONER"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⏱ 15:00"
                android:textColor="#A7A8BB"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#111827"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="NO INSTANCE"
                android:textColor="#A7A8BB"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#111827"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="AIMSHOCK"
                android:textColor="#A78BFA"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:background="#0B0F17"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:src="@drawable/player_skin_preview" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AIMSHOCK"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hubgosp.net"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="220dp"
                android:layout_height="54dp"
                android:layout_marginTop="20dp"
                android:background="#1B1F2C"
                android:gravity="center"
                android:text="LAUNCH"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Fabri: 1.21.11.1 PROD"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:background="#0D1118"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skin Animation"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="14dp"
            android:background="#151B27"
            android:scaleType="centerCrop"
            android:src="@drawable/news_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="THE RASCALS ARRIVE"
            android:textColor="#F5F5FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Wrong dimension?"
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="14dp"
            android:background="#151B27"
            android:scaleType="centerCrop"
            android:src="@drawable/news_card" />
    </LinearLayout>
</LinearLayout>
